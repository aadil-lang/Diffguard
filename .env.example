# DiffGuard Configuration

# Google Gemini API Key (Optional: Can also be configured directly in frontend Settings)
GEMINI_API_KEY=

# Default Gemini Model: gemini-2.5-flash or gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Maximum diff size allowed in bytes (1MB default)
MAX_DIFF_SIZE_BYTES=1048576

# Maximum number of files processed in a single diff
MAX_FILES_PER_DIFF=50

# Application environment
APP_ENV=development
DEBUG=True

